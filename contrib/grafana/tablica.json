{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "tablica: TRMNL devices, data sources and server health.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Devices",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Device status",
      "id": 2,
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "refId": "A",
          "expr": "max by (device, dashboard) (tablica_device_configured{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "B",
          "expr": "time() - max by (device) (tablica_device_last_seen_timestamp_seconds{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "C",
          "expr": "((time() - max by (device) (tablica_device_next_checkin_timestamp_seconds{job=\"tablica\", device=~\"$device\"})) > 1800) * 0 + 4 or ((time() - max by (device) (tablica_device_next_checkin_timestamp_seconds{job=\"tablica\", device=~\"$device\"})) > 300) * 0 + 3 or (time() - max by (device) (tablica_device_next_checkin_timestamp_seconds{job=\"tablica\", device=~\"$device\"})) * 0 + 2 or max by (device) (tablica_device_last_seen_timestamp_seconds{job=\"tablica\", device=~\"$device\"}) * 0 + 1 or max by (device) (tablica_device_configured{job=\"tablica\", device=~\"$device\"}) * 0",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "D",
          "expr": "max by (device) (tablica_device_battery_percent{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "E",
          "expr": "max by (device) (tablica_device_battery_days_left{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "F",
          "expr": "max by (device) (tablica_device_wifi_rssi_dbm{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "refId": "G",
          "expr": "max by (device, model, fw_version) (tablica_device_info{job=\"tablica\", device=~\"$device\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Since last seen"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "never",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "never seen",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "no reply yet",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "on schedule",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "late",
                        "color": "yellow",
                        "index": 3
                      },
                      "4": {
                        "text": "overdue",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Battery"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Days left"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "RSSI"
              },
              {
                "id": "unit",
                "value": "dBm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fw_version"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Firmware"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time": true,
              "Value #A": true,
              "Value #G": true,
              "dashboard": false
            },
            "indexByName": {
              "device": 0,
              "dashboard": 1,
              "Value #C": 2,
              "Value #B": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "model": 7,
              "fw_version": 8
            },
            "renameByName": {}
          }
        }
      ],
      "description": "One row per configured device. Status compares now with the deadline the device was last given: on schedule up to 5 min past it, late up to 30 min, then overdue."
    },
